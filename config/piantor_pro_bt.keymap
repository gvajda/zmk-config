/*
 * Piantor Pro BT (36-key) keymap.
 *
 * Replicates the user's kanata config: CACS home-row mods, a numbers/symbols
 * layer, a brackets/nav layer, plus thumb-enabled fn (F-keys/media/clipboard)
 * and kbd (BT/RGB/Studio/flash) layers. macOS modifiers (Cmd = LGUI).
 *
 * Uses the board's 36-key five_col_layout, so key positions are 0-35:
 *   row 0:  0- 4 left,  5- 9 right
 *   row 1: 10-14 left, 15-19 right
 *   row 2: 20-24 left, 25-29 right
 *   thumbs: 30 31 32 left, 33 34 35 right
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// Positional hold-tap trigger lists: opposite hand + all thumbs.
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33 34 35

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };

    behaviors {
        // Home-row mod, LEFT hand: hold = modifier, tap = letter.
        // Only triggers the hold if a RIGHT-hand or thumb key follows (positional),
        // which kills mis-holds during same-hand rolls. Replaces kanata's chord list.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        // Home-row mod, RIGHT hand: triggers only after a LEFT-hand or thumb key.
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // Shift-only variants of hml/hmr, tuned from a USB-log session
        // (2026-09-16, ~120 F/J instances, see README "Debugging misfires"):
        //
        //  - The user's capital-I chord is F down, I down ~100-150 ms later,
        //    F up at ~170-240 ms, I up after F. Nested release almost never
        //    happens (3 of 36 successes), so the hold is decided by the timer.
        //    At 200 ms, 5 of 8 misses were F released at 170-200 ms. 175
        //    catches those; the user's overlapped "fi" rolls (file, fill,
        //    finger) release F at 115-160 ms, so they stay taps. Next knob if
        //    misses persist: 160.
        //  - retro-tap: a lone f/j held past the term still types the letter
        //    on release instead of vanishing (lone f taps run up to 200 ms).
        //  - require-prior-idle off: 3 of 8 misses were F pressed <70 ms after
        //    a backspace/space (quick-tap verdict). The user's cross-hand rolls
        //    never nest the letter inside F, so the guard bought nothing here.
        //  - hold-preferred would fix every chord but also capitalise every
        //    overlapped roll (8 for 8 in the log): same event sequence.
        hsl: home_row_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            retro-tap;
        };
        hsr: home_row_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            retro-tap;
        };
        // Desktop switch on top row: tap = letter, hold = Ctrl+number.
        // Standalone hold (no second key needed), so no positional restriction;
        // tap-preferred favors the letter on quick taps.
        //
        // Tuned to be hard to trigger by accident:
        //   tapping-term-ms = 280   -> must deliberately hold ~0.28s before the
        //                              desktop switch fires (was 200, too twitchy).
        //   require-prior-idle-ms = 250 -> if any key was pressed within 0.25s,
        //                              this key resolves as a TAP (types the letter)
        //                              instead of switching. So pressing two keys
        //                              together / fast rolls just print letters and
        //                              never jump desktops — the disruptive case.
        hd: hold_desktop {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Squeeze both outer thumbs (esc + del) -> kbd layer (4).
        combo_kbd {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <30 35>;
            bindings = <&mo 4>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &hd LC(N1) Q  &hd LC(N2) W  &hd LC(N3) E  &hd LC(N4) R  &hd LC(N5) T      &kp Y      &kp U         &kp I         &kp O        &kp P
                &hml LCTRL A  &hml LALT S   &hml LGUI D   &hsl LSHFT F  &kp G             &kp H      &hsr RSHFT J  &hmr RGUI K   &hmr RALT L  &hmr RCTRL SEMI
                &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N      &kp M         &kp COMMA     &kp DOT      &kp FSLH
                                            &lt 3 ESC     &lt 2 SPACE   &lt 1 TAB         &lt 1 BSPC &lt 2 SPACE   &lt 3 DEL
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp EXCL         &kp AT          &kp HASH        &kp DLLR         &kp PRCNT   &kp CARET  &kp AMPS         &kp ASTRK        &kp MINUS        &kp PLUS
                &hml LCTRL N1    &hml LALT N2    &hml LGUI N3    &hml LSHFT N4    &kp N5      &kp N6     &hmr RSHFT N7    &hmr RGUI N8     &hmr RALT N9     &hmr RCTRL N0
                &kp GRAVE        &kp TILDE       &none           &none            &none       &none      &none            &none            &kp UNDER        &kp EQUAL
                                                 &trans          &trans           &trans      &trans     &trans           &trans
            >;
        };

        brc_layer {
            display-name = "BRC";
            // Outer thumbs both send enter, so enter is reachable from either hand.
            bindings = <
                &none               &kp LA(LEFT)   &kp UP          &kp LA(RIGHT)     &none          &none   &kp LBKT         &kp RBKT        &kp BSPC       &kp ESC
                &hml LCTRL LG(LEFT) &hml LALT LEFT  &hml LGUI DOWN  &hml LSHFT RIGHT  &kp LG(RIGHT)  &none   &hmr RSHFT LPAR  &hmr RGUI RPAR  &hmr RALT DQT  &hmr RCTRL SQT
                &kp GRAVE           &kp TILDE      &kp BSLH        &kp PIPE          &kp LC(B)      &none   &kp LBRC         &kp RBRC        &kp MINUS      &kp UNDER
                                                   &kp RET         &trans            &trans         &trans  &trans           &kp RET
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5      &kp F6        &kp F7        &kp F8       &kp F9   &kp F10
                &kp LG(A)  &kp LC(LS(Z))  &kp LG(LC(LA(LS(SPACE))))  &kp LG(LS(N4))  &kp LC(LG(Q))  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp F11  &kp F12
                &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &none       &none         &kp C_PREV    &kp C_PP     &kp C_NEXT  &none
                                      &trans     &trans     &trans      &trans        &trans        &trans
            >;
        };

        kbd_layer {
            display-name = "KBD";
            bindings = <
                &bootloader      &sys_reset       &none            &none           &none   &none         &none         &none         &none         &none
                &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &studio_unlock  &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &none            &none            &none            &none           &none   &bt BT_CLR    &none         &none         &none         &none
                                                  &trans           &trans          &trans  &trans        &trans        &trans
            >;
        };
    };
};
